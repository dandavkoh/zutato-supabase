Neuen Bucket anlegen: "recipes" und als public einstellen

In SQL Editor ausführen:


-- Lesen für alle (falls noch nicht vorhanden)
create policy "Public read for recipes"
on storage.objects for select
using (bucket_id = 'recipes');

-- Upload nur für angemeldete Nutzer
create policy "Authenticated users can upload recipes"
on storage.objects for insert to authenticated
with check (bucket_id = 'recipes');

-- Optional: Eigene Dateien aktualisieren
create policy "Users can update own recipes objects"
on storage.objects for update to authenticated
using (bucket_id = 'recipes' and owner = auth.uid())
with check (bucket_id = 'recipes' and owner = auth.uid());

-- Optional: Eigene Dateien löschen
create policy "Users can delete own recipes objects"
on storage.objects for delete to authenticated
using (bucket_id = 'recipes' and owner = auth.uid());